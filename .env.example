# Copy to .env and fill in. Never commit .env.

# --- Required ---------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
TOKEN=
# ID of the channel that receives the welcome messages (Discord: Developer Mode -> right-click -> Copy ID)
CHANNEL_ID=

# --- Welcome image (all optional) --------------------------------------------
# Image template: classic, centered, card, banner, minimal, split (see GET /welcome-image-generator/templates)
TEMPLATE=classic
# API base URL, no trailing slash
API_BASE=https://api.discorddevtools.xyz
# First line on the image
TITLE=Welcome to the server!
# Message line on the image (leave empty for the template default)
TEXT=
# Background image URL (http/https)
BACKGROUND=https://cdn.wallpapersafari.com/97/1/kSG1Bj.jpg
# Colors are hex without the leading #
TITLE_COLOR=a9a9a9
TEXT_COLOR=a9a9a9
USERNAME_COLOR=fff
BORDER_COLOR=a9a9a9
# Accent color used by templates that have one (banner, split, ...)
ACCENT_COLOR=
# Send "Member #N" to templates that support it. Default: on for every template except classic.
SHOW_MEMBER_COUNT=

# --- Message (optional) ------------------------------------------------------
# Title of the embed next to the image
EMBED_TITLE=Welcome!
# Embed color, hex without the leading #
EMBED_COLOR=5865f2
